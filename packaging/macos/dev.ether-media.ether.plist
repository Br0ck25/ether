<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchAgent for the Ether *server*. build-app.sh ships this template inside
  Ether.app/Contents/Resources; the tray (or `ether service install`, which
  renders the same thing via internal/service) installs it as
  ~/Library/LaunchAgents/dev.ether-media.ether.plist with __APP_CONTENTS__
  replaced by the Ether.app/Contents path, then `launchctl bootstrap`s it.
  KeepAlive mirrors PMS: the server runs while the user is logged in.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>dev.ether-media.ether</string>
	<key>ProgramArguments</key>
	<array>
		<string>__APP_CONTENTS__/Resources/ether</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>ETHER_DATA_DIR</key>
		<string>__HOME__/Library/Application Support/Ether</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>5</integer>
	<key>StandardOutPath</key>
	<string>__HOME__/Library/Logs/Ether/ether.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/Library/Logs/Ether/ether.log</string>
	<key>ProcessType</key>
	<string>Background</string>
</dict>
</plist>
