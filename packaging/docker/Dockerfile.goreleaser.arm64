# GoReleaser image: packages the already-built ether binary (build context
# root has the target binary as ./ether plus staged ffmpeg from
# scripts/fetch-ffmpeg.sh). Used by the `dockers:` section of
# .goreleaser.yaml. For from-source builds use the repo-root Dockerfile.
FROM debian:bookworm-slim

# ether runs as fixed UID/GID 999: what --system allocation gave every
# earlier image on this base, pinned so a future image can still read an
# existing 0700 /config volume. Keep in sync with the repo-root Dockerfile.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates tzdata libva2 mesa-va-drivers ocl-icd-libopencl1 \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd --system --gid 999 ether \
 && useradd --system --uid 999 --gid ether --home-dir /config --shell /usr/sbin/nologin ether \
 && mkdir -p /config /cache /usr/lib/ether \
 && chown -R ether:ether /config /cache

COPY ether /usr/lib/ether/ether
COPY dist/ffmpeg/linux-arm64/ffmpeg dist/ffmpeg/linux-arm64/ffprobe /usr/lib/ether/
COPY LICENSE THIRD_PARTY_NOTICES.md /usr/share/doc/ether/

RUN /usr/lib/ether/ether -h \
 && /usr/lib/ether/ffmpeg -version \
 && /usr/lib/ether/ffprobe -version

ENV ETHER_DATA_DIR=/config XDG_CACHE_HOME=/cache
EXPOSE 32400/tcp 32410-32414/udp
VOLUME ["/config", "/cache"]
USER ether
WORKDIR /config
ENTRYPOINT ["/usr/lib/ether/ether"]
